#!/data/data/com.termux/files/usr/bin/bash
# vps — one command to turn your phone into an SSH-able VPS.
# Run from plain Termux (NOT inside proot). Idempotent.
#
# Boots: Fedora proot -> sshd (:2222) + bore tunnel (bore.pub:22022, fixed).

DISTRO="${DISTRO:-fedora}"
PORT="${PORT:-2222}"

# keep Android from killing us
termux-wake-lock 2>/dev/null || true

LAN_IP="$(ifconfig wlan0 2>/dev/null | grep -oE 'inet [0-9.]+' | awk '{print $2}')"
[ -z "$LAN_IP" ] && LAN_IP="$(ifconfig eth0 2>/dev/null | grep -oE 'inet [0-9.]+' | awk '{print $2}')"

echo "VPS starting... (Fedora proot, sshd :$PORT + bore.pub tunnel)"
exec proot-distro login "$DISTRO" -e VPS_LAN_IP="$LAN_IP" -- /usr/local/bin/vps-start.sh
